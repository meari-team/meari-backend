PORT=3000
TZ=Asia/Seoul

# 로컬: postgresql://postgres:postgres@localhost:5432/meari_dev
# Supabase: Connection pooling(Transaction, 6543) URL + ?pgbouncer=true&connection_limit=1
DATABASE_URL=
# 마이그레이션용 직접 연결. 로컬은 DATABASE_URL과 같게, Supabase는 Session(5432) 또는 Direct URL
DIRECT_URL=
JWT_SECRET=
JWT_EXPIRES_IN=7d

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET=photos

AI_SERVER_URL=http://127.0.0.1:8001
AI_SERVICE_TOKEN=
AI_TIMEOUT_GENERATE_MS=45000
AI_TIMEOUT_CHAT_MS=30000
AI_TIMEOUT_INDEX_MS=15000
PAST_CHAT_TOP_K=5
CRISIS_FILTER_ENABLED=false

# 시연·개발용: true면 AI 서버 대신 가짜 응답 (AI_MOCK_DELAY_MS로 지연 흉내)
AI_MOCK=false
AI_MOCK_DELAY_MS=800

# 로컬 사진 저장소 (Supabase 연결 전)
STORAGE_LOCAL_DIR=uploads
# 서명 URL 앞부분. 앱이 접근하는 주소 (시뮬레이터 http://localhost:3000, 터널이면 터널 주소)
PUBLIC_BASE_URL=http://localhost:3000
