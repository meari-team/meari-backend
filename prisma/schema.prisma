// 메인 DB 스키마. 설계 근거는 meari-docs/erd.md
// 날짜(@db.Date)는 모두 KST 기준 기록일이다.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum DiaryStyle {
  PLAIN
  EMOTIONAL
  SUMMARY
}

enum EntryStatus {
  DRAFT
  QUESTIONING
  READY
  GENERATED
  CONFIRMED
}

enum AiIndexStatus {
  NONE
  PENDING
  INDEXED
  FAILED
}

enum ChatRole {
  USER
  ASSISTANT
}

// 메아리: 북마크한 일기에서 정해진 주기에 먼저 오는 연락
enum EchoFrequency {
  WEEKLY
  MONTHLY
}

enum EchoMessageSource {
  AI
  FALLBACK
}

enum EchoPushStatus {
  PENDING
  SENT
  FAILED
  NO_TOKEN
  SKIPPED
}

enum ChatFlag {
  NONE
  NO_EVIDENCE
  LEAK_BLOCKED
  CRISIS
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique @db.VarChar(255)
  passwordHash String     @map("password_hash") @db.VarChar(255)
  nickname     String     @db.VarChar(20)
  diaryStyle   DiaryStyle @default(PLAIN) @map("diary_style")
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  entries      Entry[]
  photos       Photo[]
  categories   ChecklistCategory[]
  chatSessions ChatSession[]
  schedules    Schedule[]
  echoSetting  EchoSetting?
  pushTokens   PushToken[]
  echoes       Echo[]

  @@map("users")
}

model Entry {
  id                 String        @id @default(uuid()) @db.Uuid
  userId             String        @map("user_id") @db.Uuid
  entryDate          DateTime      @map("entry_date") @db.Date
  status             EntryStatus   @default(DRAFT)
  note               String?       @db.VarChar(200)
  imageAnalysis      Json?         @map("image_analysis")
  aiDraft            String?       @map("ai_draft")
  aiUncertain        Json?         @map("ai_uncertain")
  finalContent       String?       @map("final_content")
  summary            String?       @db.VarChar(300)
  coverPhotoId       String?       @unique @map("cover_photo_id") @db.Uuid
  excludedFromMemory Boolean       @default(false) @map("excluded_from_memory")
  aiIndexStatus      AiIndexStatus @default(NONE) @map("ai_index_status")
  aiIndexError       String?       @map("ai_index_error") @db.VarChar(50)
  confirmedAt        DateTime?     @map("confirmed_at") @db.Timestamptz
  aiIndexedAt        DateTime?     @map("ai_indexed_at") @db.Timestamptz
  // 기억하고 싶은 날 (확정 일기만). 메아리 후보가 된다
  bookmarkedAt       DateTime?     @map("bookmarked_at") @db.Timestamptz
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  coverPhoto Photo?          @relation("EntryCover", fields: [coverPhotoId], references: [id], onDelete: SetNull)
  photos     Photo[]         @relation("EntryPhotos")
  questions  EntryQuestion[]
  checks     EntryCheck[]
  echoes     Echo[]
  // 부분 인덱스 2개(색인 재처리용, 확정 기록 카운트용)는 마이그레이션 SQL에 직접 추가했다

  @@unique([userId, entryDate])
  @@map("entries")
}

model Photo {
  id         String   @id @default(uuid()) @db.Uuid
  entryId    String   @map("entry_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  storageKey String   @map("storage_key") @db.VarChar(255)
  width      Int?
  height     Int?
  caption    String?  @db.VarChar(100)
  sortOrder  Int      @map("sort_order") @db.SmallInt
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  entry   Entry  @relation("EntryPhotos", fields: [entryId], references: [id], onDelete: Cascade)
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  coverOf Entry? @relation("EntryCover")

  @@index([entryId, sortOrder])
  @@map("photos")
}

model EntryQuestion {
  id           String  @id @default(uuid()) @db.Uuid
  entryId      String  @map("entry_id") @db.Uuid
  aiQuestionId String  @map("ai_question_id") @db.VarChar(40)
  question     String  @db.VarChar(500)
  reason       String  @db.VarChar(500)
  options      Json?
  answer       String? @db.VarChar(2000)
  skipped      Boolean @default(false)
  sortOrder    Int     @map("sort_order") @db.SmallInt

  entry Entry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@index([entryId, sortOrder])
  @@map("entry_questions")
}

model ChecklistCategory {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  name      String   @db.VarChar(20)
  color     String   @db.Char(7)
  sortOrder Int      @map("sort_order") @db.SmallInt
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  items ChecklistItem[]

  @@index([userId, sortOrder])
  @@map("checklist_categories")
}

model ChecklistItem {
  id         String @id @default(uuid()) @db.Uuid
  categoryId String @map("category_id") @db.Uuid
  label      String @db.VarChar(20)
  sortOrder  Int    @map("sort_order") @db.SmallInt

  category ChecklistCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  checks   EntryCheck[]

  @@index([categoryId, sortOrder])
  @@map("checklist_items")
}

model EntryCheck {
  entryId String @map("entry_id") @db.Uuid
  itemId  String @map("item_id") @db.Uuid

  entry Entry         @relation(fields: [entryId], references: [id], onDelete: Cascade)
  item  ChecklistItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@id([entryId, itemId])
  @@index([itemId])
  @@map("entry_checks")
}

model ChatSession {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  anchorDate    DateTime  @map("anchor_date") @db.Date
  messageCount  Int       @default(0) @map("message_count")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  lastMessageAt DateTime? @map("last_message_at") @db.Timestamptz

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages ChatMessage[]
  echo     Echo?

  @@index([userId, lastMessageAt(sort: Desc)])
  @@map("chat_sessions")
}

model ChatMessage {
  id        String   @id @default(uuid()) @db.Uuid
  sessionId String   @map("session_id") @db.Uuid
  role      ChatRole
  content   String
  citations Json?
  flag      ChatFlag @default(NONE)
  latencyMs Int?     @map("latency_ms")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@map("chat_messages")
}

// 캘린더 일정. 일기 생성 때 그날 일정을 AI 설명에 덧붙인다
model Schedule {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  date      DateTime @db.Date
  title     String   @db.VarChar(50)
  time      String?  @db.VarChar(5) // "HH:mm", 없으면 종일
  completed Boolean  @default(false) // 캘린더 체크박스
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@map("schedules")
}

// 메아리 설정 (사용자당 1행). 없으면 미동의로 본다
model EchoSetting {
  userId      String        @id @map("user_id") @db.Uuid
  enabled     Boolean       @default(false)
  frequency   EchoFrequency @default(WEEKLY)
  weekday     Int           @default(0) @db.SmallInt // 주 1회: 0=일 … 6=토
  monthDay    Int           @default(1) @map("month_day") @db.SmallInt // 월 1회: 1~31, 없는 날이면 그달 마지막 날
  minuteOfDay Int           @default(1260) @map("minute_of_day") @db.SmallInt // 하루 중 분 (21:00 = 1260)
  timezone    String        @default("Asia/Seoul") @db.VarChar(64)
  showPreview Boolean       @default(false) @map("show_preview") // 알림에 메시지 내용 보이기
  // 다음 예약 회차. 미동의면 null (다시 동의하면 지금 이후 회차부터)
  nextRunAt   DateTime?     @map("next_run_at") @db.Timestamptz
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([nextRunAt])
  @@map("echo_settings")
}

// 기기 푸시 토큰 (Expo push token)
model PushToken {
  token     String   @id @db.VarChar(255)
  userId    String   @map("user_id") @db.Uuid
  platform  String   @db.VarChar(10)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_tokens")
}

// 도착한 메아리. 같은 회차(slotKey)는 한 번만 만든다
model Echo {
  id           String            @id @default(uuid()) @db.Uuid
  userId       String            @map("user_id") @db.Uuid
  entryId      String            @map("entry_id") @db.Uuid
  slotKey      String            @map("slot_key") @db.VarChar(64)
  sessionId    String?           @unique @map("session_id") @db.Uuid
  message      String
  source       EchoMessageSource
  citations    Json
  // 근거 일기 버전 (그 시점의 확정 시각)
  entryVersion DateTime          @map("entry_version") @db.Timestamptz
  readAt       DateTime?         @map("read_at") @db.Timestamptz
  pushStatus   EchoPushStatus    @default(PENDING) @map("push_status")
  pushAttempts Int               @default(0) @map("push_attempts") @db.SmallInt
  pushError    String?           @map("push_error") @db.VarChar(100)
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  entry   Entry        @relation(fields: [entryId], references: [id], onDelete: Cascade)
  session ChatSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@unique([userId, slotKey])
  @@index([userId, createdAt(sort: Desc)])
  @@index([entryId])
  @@index([pushStatus])
  @@map("echoes")
}
